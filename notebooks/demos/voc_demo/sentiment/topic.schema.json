{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VOC topic output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic_run_id",
    "dataset_release_id",
    "embedding_run_id",
    "run_manifest_ref",
    "cluster_id",
    "topic_id",
    "keywords",
    "assigned_review_ids",
    "review_count",
    "representative_examples",
    "proposed_feature",
    "topic_description",
    "supporting_review_ids",
    "assessment",
    "interpretation_status",
    "interpretation_provenance",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "voc-topic-v1"
    },
    "topic_run_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "dataset_release_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "embedding_run_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "run_manifest_ref": {
      "$ref": "#/$defs/nonemptyString"
    },
    "cluster_id": {
      "type": "integer",
      "minimum": 0
    },
    "topic_id": {
      "type": "integer",
      "minimum": 0
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "c_tf_idf_weight"
        ],
        "properties": {
          "term": {
            "$ref": "#/$defs/nonemptyString"
          },
          "c_tf_idf_weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "assigned_review_ids": {
      "$ref": "#/$defs/nonemptyIds"
    },
    "review_count": {
      "type": "integer",
      "minimum": 1
    },
    "representative_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "embedding_text"
        ],
        "properties": {
          "record_id": {
            "$ref": "#/$defs/nonemptyString"
          },
          "embedding_text": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "proposed_feature": {
      "$ref": "#/$defs/nullableText"
    },
    "topic_description": {
      "$ref": "#/$defs/nullableText"
    },
    "supporting_review_ids": {
      "$ref": "#/$defs/ids"
    },
    "assessment": {
      "enum": [
        null,
        "single_feature",
        "mixed",
        "unclear"
      ]
    },
    "interpretation_status": {
      "enum": [
        "pending",
        "completed",
        "failed"
      ]
    },
    "interpretation_provenance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance"
        }
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "proposed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "interpretation_status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "topic_description": {
            "$ref": "#/$defs/nonemptyString"
          },
          "supporting_review_ids": {
            "$ref": "#/$defs/nonemptyIds"
          },
          "assessment": {
            "enum": [
              "single_feature",
              "mixed",
              "unclear"
            ]
          },
          "interpretation_provenance": {
            "$ref": "#/$defs/provenance"
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "else": {
        "properties": {
          "proposed_feature": {
            "type": "null"
          },
          "topic_description": {
            "type": "null"
          },
          "supporting_review_ids": {
            "maxItems": 0
          },
          "assessment": {
            "type": "null"
          },
          "review_status": {
            "const": "unreviewed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "const": "single_feature"
          }
        }
      },
      "then": {
        "properties": {
          "proposed_feature": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      },
      "else": {
        "properties": {
          "proposed_feature": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableText": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonemptyString"
        }
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "nonemptyIds": {
      "allOf": [
        {
          "$ref": "#/$defs/ids"
        },
        {
          "minItems": 1
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "model_id",
        "prompt_version",
        "evidence_review_ids"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "model_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "prompt_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_review_ids": {
          "$ref": "#/$defs/nonemptyIds"
        }
      }
    }
  }
}
