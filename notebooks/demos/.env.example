# Private demo configuration. Copy to .env in this directory.
AWS_BUCKET=REPLACE_WITH_BUCKET_NAME
AWS_REGION=us-east-2
# Use literal credentials with docker compose, or op:// references with op run.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional: needed only when explicitly generating new topic interpretations.
OPENROUTER_API_KEY=
# Only required when explicitly publishing a new demo checkpoint.
DEMO_MEMBER_ID=
# Separate from the main VOC application's port.
DEMO_PORT=2730
