# Run these recipes on the Mac. Python is needed for project/package tooling, not app execution.
derived := env_var_or_default("VOC_DATA_STATE_DERIVED_DATA", env_var("HOME") + "/Library/Developer/VOCDataState-DerivedData")
architecture := `uname -m`

project:
    python3 scripts/generate-project.py

build:
    xcodebuild build -project VOCDataState.xcodeproj -scheme VOCDataState -configuration Debug -destination 'platform=macOS,arch={{architecture}}' -derivedDataPath '{{derived}}'

test:
    xcodebuild test -project VOCDataState.xcodeproj -scheme VOCDataState -configuration Debug -destination 'platform=macOS,arch={{architecture}}' -derivedDataPath '{{derived}}'

open:
    open '{{derived}}/Build/Products/Debug/VOCDataState.app'

# Read {"request_id":"UUID","question":"..."} from stdin and open the bundled app.
handoff:
    '{{derived}}/Build/Products/Debug/VOCDataState.app/Contents/Helpers/VOCDesktopBridge' submit

handoff-status work_id:
    '{{derived}}/Build/Products/Debug/VOCDataState.app/Contents/Helpers/VOCDesktopBridge' status '{{work_id}}'

# Print the actual helper path for Claude; this does not edit its configuration.
claude-config:
    '{{derived}}/Build/Products/Debug/VOCDataState.app/Contents/Helpers/VOCDesktopBridge' --claude-config

# Protocol-only stdout; normally Claude launches the helper directly.
mcp-stdio:
    '{{derived}}/Build/Products/Debug/VOCDataState.app/Contents/Helpers/VOCDesktopBridge' --stdio

# Optional foreground transport for container clients. Uses a separate 1Password credential.
mcp-http:
    bash scripts/start-mcp-http.sh '{{derived}}/Build/Products/Debug/VOCDataState.app/Contents/Helpers/VOCDesktopBridge'

# Create a verified private ZIP without installing it or touching running builds.
package: package-tests
    python3 scripts/package.py

package-tests:
    python3 -m unittest discover -s Tests -p test_packaging.py

# Resolve supplied paths from the caller's directory, even with --justfile.
[no-cd]
verify-installed manifest app="/Applications/VOCDataState.app":
    python3 '{{justfile_directory()}}/scripts/verify-installed.py' '{{app}}' --manifest '{{manifest}}'

installed-claude-config:
    '/Applications/VOCDataState.app/Contents/Helpers/VOCDesktopBridge' --claude-config

installed-mcp-http:
    bash scripts/start-mcp-http.sh '/Applications/VOCDataState.app/Contents/Helpers/VOCDesktopBridge'
