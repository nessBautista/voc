# Copy to .env for your own settings; never put actual secrets in this example.

# --- Docker project and local data ---
# Compose project name; the workspace container is named voc-aws-rebuild-workspace-1.
COMPOSE_PROJECT_NAME=voc-aws-rebuild
# Runtime files live in the repo data/ folder, available at /workspace/data.

# --- AWS credentials ---
# Choose credentials from a local file (env-file) or 1Password (1password).
VOC_AWS_AUTH_MODE=env-file
# One private file: actual keys for env-file mode, op:// references for 1password.
VOC_AWS_ENV_FILE=config/aws.local.env

# --- S3 location and personal identity ---
# S3 bucket name, without s3:// or a folder path.
AWS_BUCKET=itesm-mna-datos-equipo14-voc
# AWS region code for the bucket; us-east-2 is Ohio.
AWS_REGION=us-east-2
# Your identifier in personal S3 paths; this is not an AWS login.
VOC_MEMBER_ID=ness-rebuild

# --- Dataset and artifact storage ---
# Read shared S3 releases (s3) or personal publications (personal).
VOC_DATASET_SOURCE=s3
# Save personal ZenML/MLflow artifact files to s3 or local; databases stay local.
VOC_ARTIFACT_DESTINATION=s3

# --- Notebook login ---
# Private token for Jupyter and Marimo; set it in .env before starting them.
JUPYTER_TOKEN=

# --- Browser ports on your host ---
# JupyterLab: http://127.0.0.1:8890
VOC_JUPYTER_PORT=8890
# Marimo notebook editor: http://127.0.0.1:2721
VOC_MARIMO_PORT=2721
# ZenML dashboard: http://127.0.0.1:8239
VOC_ZENML_PORT=8239
# MLflow dashboard: http://127.0.0.1:5002
VOC_MLFLOW_PORT=5002
# VOC dataset dashboard: http://127.0.0.1:8052
VOC_DASHBOARD_PORT=8052

# --- End-user application ---
VOC_APP_PORT=8091
# fixture uses deterministic examples; model uses the private credential loader.
VOC_PLANNER_MODE=fixture
VOC_LLM_BASE_URL=https://openrouter.ai/api/v1
VOC_LLM_MODEL=anthropic/claude-sonnet-5.5
VOC_TURN_TIMEOUT_SECONDS=45
# MCP shares this app's URL and conversation service. Disabled unless explicitly enabled.
VOC_MCP_ENABLED=false
# VOC_MCP_TOKEN belongs in the private credential file, never here or in a URL.
# Optional comma-separated overrides: explicit hosts (including ports) and origins.
# VOC_MCP_ALLOWED_HOSTS=127.0.0.1:8091,localhost:8091,host.docker.internal:8091,127.0.0.1:8000
# VOC_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8091,http://localhost:8091
