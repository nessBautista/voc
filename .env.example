# Copy to .env for your own settings; never put actual secrets in this example.

# --- Docker project and local data ---
# Launchers pin this project; the workspace container is voc-main-workspace-1.
COMPOSE_PROJECT_NAME=voc-main
# Runtime files live in the repo data/ folder, available at /workspace/data.

# --- AWS credentials ---
# Choose credentials from a local file (env-file) or 1Password (1password).
VOC_AWS_AUTH_MODE=env-file
# One private file: actual keys for env-file mode, op:// references for 1password.
VOC_AWS_ENV_FILE=config/aws.local.env

# --- S3 location and personal identity ---
# Leave blank for local work; choose your own bucket before opting into S3.
AWS_BUCKET=
# AWS region code for the bucket; us-east-2 is Ohio.
AWS_REGION=us-east-2
# Your identifier in personal S3 paths; this is not an AWS login.
VOC_MEMBER_ID=personal

# --- Dataset and artifact storage ---
# Read personal publications (personal) or shared S3 releases (s3).
VOC_DATASET_SOURCE=personal
# Save personal ZenML/MLflow artifact files locally; S3 is an explicit opt-in.
VOC_ARTIFACT_DESTINATION=local

# --- Notebook login ---
# Private token for Jupyter and Marimo; set it in .env before starting them.
JUPYTER_TOKEN=

# --- Browser ports on your host ---
# JupyterLab: http://127.0.0.1:8891
VOC_JUPYTER_PORT=8891
# Marimo notebook editor: http://127.0.0.1:2722
VOC_MARIMO_PORT=2722
# ZenML dashboard: http://127.0.0.1:8240
VOC_ZENML_PORT=8240
# MLflow dashboard: http://127.0.0.1:5003
VOC_MLFLOW_PORT=5003
# VOC dataset dashboard: http://127.0.0.1:8052
VOC_DASHBOARD_PORT=8052
