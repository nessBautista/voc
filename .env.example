# Copy to .env and set a private Jupyter/Marimo login token. Never commit .env.
VOC_AWS_AUTH_MODE=env-file
VOC_AWS_ENV_FILE=config/aws.local.env
# Existing 1Password users select 1password and use config/aws.refs.env instead.
VOC_STORAGE_MODE=bind
VOC_RUNTIME_DIR=./data
# No seed is needed to read shared releases. Publishers may set a host directory.
VOC_SEED_DIR=
JUPYTER_TOKEN=
VOC_ZENML_PORT=8237
VOC_MLFLOW_PORT=5000
VOC_JUPYTER_PORT=8888
VOC_MARIMO_PORT=2719
VOC_DASHBOARD_PORT=8050
