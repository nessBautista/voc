# Copy to config/aws.local.env; edit the private copy, never this template.
# VOC_AWS_AUTH_MODE in the root .env chooses how these values are read:
#   env-file: actual AWS credentials (keep values single-quoted).
#   1password: op:// references, resolved by op run before Compose starts.
# Keep bucket, region and member settings in the root .env.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
# Leave empty unless your AWS credentials include a session token.
AWS_SESSION_TOKEN=''

# For 1password mode, replace the values above with your own references, e.g.:
# AWS_ACCESS_KEY_ID='op://VAULT/ITEM/Access Key ID'
# AWS_SECRET_ACCESS_KEY='op://VAULT/ITEM/Secret Access Key'
# AWS_SESSION_TOKEN='op://VAULT/ITEM/Session Token'

# Optional OpenRouter key for notebook topic interpretation (empty when unused).
# env-file mode: put the actual key in your private copy.
# 1password mode: use your own op://VAULT/ITEM/FIELD reference.
OPENROUTER_API_KEY=''
