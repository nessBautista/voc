# Copy to config/aws.local.env. Edit the COPY only; never commit actual keys.
# Compose reads this file as data. Keep values single-quoted, especially secrets.
# This local file contains plaintext secrets, unlike the 1Password reference file.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
# Include the actual token only if AWS supplied temporary session credentials.
AWS_SESSION_TOKEN=''
AWS_REGION='us-east-2'
AWS_BUCKET=''
VOC_MEMBER_ID=''
VOC_ARTIFACT_DESTINATION='s3'
VOC_DATASET_SOURCE='s3'
