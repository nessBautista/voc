# Copy to config/aws.refs.env (ignored by Git and Docker builds).
# Use "Copy Secret Reference" on each field in the 1Password desktop app.
# References may include a section name; use the exact URI copied from the app.
# Never replace these references with plaintext credentials.
AWS_ACCESS_KEY_ID="op://YOUR_VAULT/YOUR_ITEM/Access Key ID"
AWS_SECRET_ACCESS_KEY="op://YOUR_VAULT/YOUR_ITEM/Secret Access Key"
# Include only for credentials that require a session token:
# AWS_SESSION_TOKEN="op://YOUR_VAULT/YOUR_ITEM/Session Token"
AWS_REGION=us-east-2
AWS_BUCKET=REPLACE_WITH_BUCKET_NAME
VOC_MEMBER_ID=ness
VOC_SMOKE_KEY=members/ness/tests/REPLACE_WITH_HOST_TEST_UUID/host.txt
