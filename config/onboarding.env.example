# Copy to .env ONLY in a separate fresh checkout for the onboarding exercise.
# These settings isolate its containers, data, and ports from your current project.
COMPOSE_PROJECT_NAME=voc-onboarding
VOC_AWS_AUTH_MODE=env-file
VOC_AWS_ENV_FILE=config/aws.local.env
VOC_STORAGE_MODE=bind
VOC_RUNTIME_DIR=./data
VOC_SEED_DIR=
JUPYTER_TOKEN=
VOC_ZENML_PORT=8238
VOC_MLFLOW_PORT=5001
VOC_JUPYTER_PORT=8889
VOC_MARIMO_PORT=2720
VOC_DASHBOARD_PORT=8051
