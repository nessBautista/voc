# Copy to config/lang-studio.local.env (ignored by Git). Never commit API keys.
# Studio's web UI uses your LangSmith login; follow its API-key setup if requested.
LANGSMITH_API_KEY=

# Fixture mode uses the real local publication without a model-provider request.
VOC_STUDIO_PLANNER_MODE=fixture
# For model tests only: set mode=model and supply your OpenRouter key here.
VOC_STUDIO_LLM_API_KEY=
VOC_STUDIO_LLM_MODEL=anthropic/claude-sonnet-5.5

# Optional absolute paths when the local publication is stored elsewhere.
# VOC_STUDIO_PUBLICATIONS_DIR=/absolute/path/to/catalog
# VOC_STUDIO_PUBLICATION_STATE_DIR=/absolute/path/to/state
